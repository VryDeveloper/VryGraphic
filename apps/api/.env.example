# Copie para .env (o passo a passo do README faz isso).
# Banco do docker-compose (porta 5433 para não brigar com outro Postgres na 5432)
DATABASE_URL="postgresql://vry:vry@localhost:5433/vrygraphic?schema=public"

# Troque por uma frase longa e aleatória. Nunca suba o .env para o GitHub.
JWT_SECRET="troque-por-uma-frase-longa-e-aleatoria-com-32-caracteres-ou-mais"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_DAYS=7

PORT=3333
WEB_ORIGIN="http://localhost:5173"
NODE_ENV="development"
# jobs de contas fixas e alertas (a cada hora)
JOBS_ENABLED=true
# recria o usuário demo todo dia às 4h (deixe false no seu PC)
DEMO_RESET=false
# Vry Agent (aba Agente): chave da API da Anthropic. Sem ela a aba mostra como configurar.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# teto de mensagens ao agente por dia, somando todo mundo
AGENT_DAILY_LIMIT=300
# Modo Dev: terminal real dentro do app para rodar o Claude Code (só no seu PC, nunca em produção)
DEV_TERMINAL=false
